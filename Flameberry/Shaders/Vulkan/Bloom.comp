#version 450

layout(constant_id = 0) const uint c_MaxDescriptorSetsAllowed = 8;
layout(constant_id = 1) const uint c_MipLevels = 10;

layout(set = 0, binding = 0, rgba16f)   uniform image2D _FBY_u_TargetImage;
layout(set = 0, binding = 1)		  uniform sampler2D _FBY_u_BloomImageSampler;
layout(set = 0, binding = 2, rgba16f) uniform image2D _FBY_u_BloomImages[c_MaxDescriptorSetsAllowed];

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define BLOOM_STAGE_PREFILTER 0
#define BLOOM_STAGE_DOWNSAMPLE 1
#define BLOOM_STAGE_UPSAMPLE 2

const float Epsilon = 1.0e-4;

layout(push_constant) uniform BloomSettings {
 	float Threshold, Knee;
	uint BloomStage;
	uint InputIndex, OutputIndex;
} u_BloomSettings;

// Quadratic color thresholding
// curve = (threshold - knee, knee * 2, 0.25 / knee)
vec4 QuadraticThreshold(vec4 color, float threshold, vec3 curve)
{
    // Maximum pixel brightness
    float brightness = max(max(color.r, color.g), color.b);
    // Quadratic curve
    float rq = clamp(brightness - curve.x, 0.0, curve.y);
    rq = (rq * rq) * curve.z;
    color *= max(rq, brightness - threshold) / max(brightness, Epsilon);
    return color;
}

vec4 PrefilterStage(vec4 color, vec4 params)
{
    float clampValue = 20.0f;
    color = min(vec4(clampValue), color);
    color = QuadraticThreshold(color, params.x, params.yzw);
    return color;
}

vec3 DownsampleBox13(sampler2D tex, float lod, vec2 uv, vec2 texelSize)
{
    // Center (1.0 weight)
    vec3 A = textureLod(tex, uv, lod).rgb;

    texelSize *= 2.0f; // Sample from center of texels

    // Inner box (4 samples at 0.5 weight)
    vec3 B = textureLod(tex, uv + texelSize * vec2(-1.0f, -1.0f), lod).rgb;
    vec3 C = textureLod(tex, uv + texelSize * vec2(-1.0f, 1.0f), lod).rgb;
    vec3 D = textureLod(tex, uv + texelSize * vec2(1.0f, 1.0f), lod).rgb;
    vec3 E = textureLod(tex, uv + texelSize * vec2(1.0f, -1.0f), lod).rgb;

    // Outer box (8 samples at 0.125 weight)
    vec3 F = textureLod(tex, uv + texelSize * vec2(-2.0f, -2.0f), lod).rgb;
    vec3 G = textureLod(tex, uv + texelSize * vec2(-2.0f, 0.0f), lod).rgb;
    vec3 H = textureLod(tex, uv + texelSize * vec2(0.0f, 2.0f), lod).rgb;
    vec3 I = textureLod(tex, uv + texelSize * vec2(2.0f, 2.0f), lod).rgb;
    vec3 J = textureLod(tex, uv + texelSize * vec2(2.0f, -2.0f), lod).rgb;
    vec3 K = textureLod(tex, uv + texelSize * vec2(2.0f, 0.0f), lod).rgb;
    vec3 L = textureLod(tex, uv + texelSize * vec2(0.0f, -2.0f), lod).rgb;
    vec3 M = textureLod(tex, uv + texelSize * vec2(-2.0f, 2.0f), lod).rgb;

    // Weighted sum (1.0 + 4*0.5 + 8*0.125 = 4.0 total weight)
    vec3 result = A * 1.0; // Center
    result += (B + C + D + E) * 0.5; // Inner box
    result += (F + G + H + I + J + K + L + M) * 0.125; // Outer box
    
    // Normalize by total weight
    return result / 4.0;
}

void main()
{
	// (x) threshold, (y) threshold - knee, (z) knee * 2, (w) 0.25 / knee
	const vec4 params = vec4(u_BloomSettings.Threshold, u_BloomSettings.Threshold - u_BloomSettings.Knee, u_BloomSettings.Knee * 2.0, 0.25 / u_BloomSettings.Knee);

	const vec2 imgSize = vec2(imageSize(_FBY_u_BloomImages[u_BloomSettings.OutputIndex]));

	ivec2 invocID = ivec2(gl_GlobalInvocationID);
    vec2 texCoords = vec2(float(invocID.x) / imgSize.x, float(invocID.y) / imgSize.y);
    texCoords += (1.0f / imgSize) * 0.5f;

	vec2 texSize = vec2(textureSize(_FBY_u_BloomImageSampler, int(u_BloomSettings.InputIndex)));

	if (u_BloomSettings.BloomStage == BLOOM_STAGE_PREFILTER)
	{
		vec4 color = imageLoad(_FBY_u_TargetImage, ivec2(gl_GlobalInvocationID.xy));
		color = PrefilterStage(color, params);
		color.a = 1.0f; // Confirm whether we need this
		imageStore(_FBY_u_BloomImages[u_BloomSettings.OutputIndex], ivec2(gl_GlobalInvocationID.xy), color);
	}
	else if (u_BloomSettings.BloomStage == BLOOM_STAGE_DOWNSAMPLE)
	{
		// vec4 color = imageLoad(_FBY_u_BloomImages[u_BloomSettings.InputIndex], ivec2(gl_GlobalInvocationID.xy));
		vec4 color = vec4(1.0);
		color.rgb = DownsampleBox13(_FBY_u_BloomImageSampler, float(u_BloomSettings.OutputIndex), texCoords, 1.0f / texSize);
		imageStore(_FBY_u_BloomImages[u_BloomSettings.OutputIndex], ivec2(gl_GlobalInvocationID.xy), color);
	}
}
